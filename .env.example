# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Meta (Facebook Page / Messenger) ---
# Long-lived Page Access Token for the doctor's Facebook Page
META_PAGE_ACCESS_TOKEN=your_page_access_token_here
# Arbitrary secret string you define; must match the value set in the Meta App webhook config
META_VERIFY_TOKEN=your_custom_verify_token_here

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Optional: fallback model if primary model experiences high load / timeouts
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
