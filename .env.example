# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Meta (Facebook Page / Messenger) ---
# Long-lived Page Access Token for the doctor's Facebook Page
META_PAGE_ACCESS_TOKEN=your_page_access_token_here
# App Secret from Meta for Developers (App Settings -> Basic).
# Used to verify X-Hub-Signature-256 on incoming webhooks. Strongly recommended.
META_APP_SECRET=your_meta_app_secret_here
# Arbitrary secret string you define; must match the value set in the Meta App webhook config
META_VERIFY_TOKEN=your_custom_verify_token_here

# --- AI Provider (Layer 3 conversational engine) ---
# Which engine answers clinical/general questions: gemini | claude | auto
# "auto" uses Claude when ANTHROPIC_API_KEY is set, otherwise Gemini.
AI_PROVIDER=gemini
# Optional second engine tried only if the primary fails: gemini | claude | (empty)
AI_FALLBACK_PROVIDER=

# --- Google Gemini (active engine) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default model (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
# Optional: fallback model if the primary is overloaded/times out
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# --- Anthropic Claude (optional alternative engine) ---
# Get a key at https://console.anthropic.com/ (starts with sk-ant-api03-).
# To use Claude instead: set AI_PROVIDER=claude (or auto) and fill the key below.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FALLBACK_MODEL=claude-haiku-5-5
# Reasoning effort: low | medium | high | xhigh | max (low = fastest/cheapest)
CLAUDE_EFFORT=low

# --- CORS (optional) ---
# Comma-separated origins allowed to call this API from a browser. Empty = none.
CORS_ALLOW_ORIGINS=
